/dts-v1/;

#include <nordic/nrf52810_qfaa.dtsi>
#include "t_parasite-pinctrl.dtsi"

/ {
	model = "plant_soil_meter";
	compatible = "Travis_Leaton,t-parasite";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	zephyr,user {
		io-channels = <&adc 0>, <&adc 2>;
	};

	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			// P0.30.
			gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			// P0.29.
			gpios = <&gpio0 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button SW1";
		};
	};

	soil_pwm: soil_pwm {
		compatible = "pwm-fixed";
		pwms = <&pwm0 0 PWM_USEC(2) PWM_POLARITY_NORMAL>;
		pulse = <PWM_USEC(1)>;
	};

	soil_calibration_coeffs: soil_calibration_coeffs {
		compatible = "soil-calibration-coeffs";
		dry = <306000 101000 (-11700)>;
		wet = <19000 (-4980) 3420>;
	};


};

&uicr {
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
	// For low-power EDGE interrupts.
	// See github.com/zephyrproject-rtos/zephyr/issues/28499.
	sense-edge-mask = <0xffffffff>;
};

&i2c0 {
	compatible = "nordic,nrf-twi";
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	shtc3: shtc3@70 {
		compatible = "i2c-device";
		reg = <0x70>;
		label = "SHTC3";
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	// Soil.
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_VDD_1_4";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		// P0.03.
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <10>;

	};

	// Battery.
	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <10>;
	};
};

// &reg {
// 	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
// };

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x00000000 0x2A000>;
		};
		storage_partition: partition@2a000 {
			label = "storage";
			reg = <0x0002A000 0x00006000>;
		};
	};
};
